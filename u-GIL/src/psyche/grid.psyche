;;; *************************************************************************************
;;;  grid.psyche — the Eidos world interface
;;;
;;;  εἶδος, "to see."  A 64x64 grid, 16 colours, 7 actions, turn-based: the
;;;  world changes only when the agent acts.
;;;
;;;  The Psyche mediates two flows and speaks four tuples.  What is
;;;  PER-DEVICE is only the :Channel it offers, the :Data it emits, its
;;;  :Content vocabulary and its actuation repertoire.  Everything behind
;;;  the Perceiver is shared with the Expanse.
;;;
;;;  Transport: native HTTPS where the runtime has it; otherwise the file
;;;  protocol with etc/bridge.py, which owns every protocol detail the mind
;;;  must never see.
;;; *************************************************************************************

(theory Eidos {2 0 0}

  "Eidos — the ARC-AGI-3 Psyche."

  ;; ── registration ──────────────────────────────────────────
  ;; Level 0 of the action ladder: the device declares what it
  ;; can do.  It does NOT declare what any of it means.

  (function eidos-register {}
    (ask (setting Observation Registrar :Url)
      { :Device     Eidos
        :Type       Psyche
        :Modality   Eidos
        :Channels   {Grid}
        :Needs      {progress efficiency}
        :Actuations {reset action1 action2 action3 action4
                     action5 action6 action7} }))


  ;; ── inbound: frame -> PERCEPT ─────────────────────────────

  (function grid-percept {variant ?frame}
    [PERCEPT :Modality Eidos
             :Channel  Grid
             :Address  (setting Eidos API :Url)
             :Data     grid-state
             :Content  (idiom :GameId          (:GameId ?frame)
                              :Level           (:Level ?frame)
                              :Width           (setting Eidos Grid :Width)
                              :Height          (setting Eidos Grid :Height)
                              :Grid            (:Grid ?frame)
                              :State           (:State ?frame)
                              :LevelsCompleted (:LevelsCompleted ?frame)
                              :TotalLevels     (:TotalLevels ?frame)
                              :ActionsUsed     (:ActionsUsed ?frame)
                              :HumanActions    (:HumanActions ?frame)
                              :AvailableActions (:AvailableActions ?frame))
             :Moment   (moment)
             :Token    (eidos-token)])

  ;; frame-arrived — one frame in, up to three percepts out, and
  ;; the efficiency urge if the mind is burning actions.
  (function grid-frame-arrived {variant ?frame}
    (tell (setting Observation Perceiver :Url) (grid-percept ?frame))

    ;; what changed, keyed by the act that caused it
    (when (thing-p (:Changes ?frame))
      (tell (setting Observation Perceiver :Url)
        [PERCEPT :Modality Eidos :Channel Grid :Data grid-delta
                 :Content (idiom :Changes (:Changes ?frame)
                                 :Count   (# (:Changes ?frame))
                                 :Cause   (:Cause ?frame))
                 :Moment (moment) :Token (eidos-token)]))

    ;; win or game-over is an experience in its own right
    (when (/= (:State ?frame) "playing")
      (tell (setting Observation Perceiver :Url)
        [PERCEPT :Modality Eidos :Channel Grid :Data game-event
                 :Content (idiom :State (:State ?frame)
                                 :LevelsCompleted (:LevelsCompleted ?frame))
                 :Moment (moment) :Token (eidos-token)]))

    ;; RHAE = (human / agent)^2.  Past 3x the human baseline the
    ;; score is effectively lost, so this is a real homeostatic
    ;; signal, not bookkeeping.
    (var ?used  (:ActionsUsed  ?frame))
    (var ?human (:HumanActions ?frame))
    (when (and (thing-p ?human) (> ?human 0) (> ?used (* 3 ?human)))
      (tell (setting Observation Perceiver :Url)
        [URGE :Need efficiency :Source Grid
              :Delta (/ ?used ?human) :Moment (moment)
              :Token (eidos-token)]))

    ;; keep the Capability rows honest: only what is on offer now
    (grid-capabilities (:AvailableActions ?frame)))

  ;; grid-capabilities — the mind reads what is available rather
  ;; than being told which acts to ignore.
  (function grid-capabilities {list ?available}
    (with [Actuation :M as ?a :Name as ?name :Device = Eidos]
      do
      (var ?on (if (in ?available ?name) yes no))
      (with [Capability ^ as ?c :Action = ?a]
        do (put ?c :Enabled ?on :Moment (moment))
        else (new Capability :Action ?a :Enabled ?on :Moment (moment)))))


  ;; ── outbound: ATTEMPT -> the world ────────────────────────

  (function grid-handler {?sender ?message}
    (when (= (@ ?message 1) ATTEMPT)
      (var ?action (:Action ?message))
      (var ?params (:Parameters ?message))
      (var ?reason (:Reason ?message))
      (try
        (var ?frame (grid-dispatch ?action ?params ?reason))
        (grid-frame-arrived ?frame)
        (tell (setting Observation Perceiver :Url)
          [RESULT :Action ?action :Status succeeded
                  :Reason (:State ?frame) :Moment (moment)
                  :Token (eidos-token)])
      learn ?err
        (tell (setting Observation Perceiver :Url)
          [RESULT :Action ?action :Status failed :Reason (string ?err)
                  :Moment (moment) :Token (eidos-token)]))))

  ;; grid-dispatch — native transport if the runtime has it,
  ;; otherwise the file protocol.  The mind cannot tell which.
  (function grid-dispatch {literal ?action variant ?params variant ?reason}
    (if (network-available-p)
        (eidos-api-command ?action ?params ?reason)
        (grid-file-command ?action ?params ?reason)))

  (function network-available-p {}
    (try (do (var ?h (open (setting Eidos API :Url) {})) (close ?h) yes)
      learn ?e no))

  ;; ── the file protocol ─────────────────────────────────────
  ;; Write the reason sidecar BEFORE the action file: the bridge
  ;; consumes action files on sight, so the reason must already
  ;; be there.  The world's own log then records WHY.

  (function grid-file-command {literal ?action variant ?params variant ?reason}
    (var ?outbox (setting Eidos Frames :Outbox))
    (var ?n 1)
    (while (= (gone ($$ ?outbox "/action-" (string ?n) ".txt")) no)
      (set ?n (+ ?n 1)))
    (when (thing-p ?reason)
      (write ($$ ?outbox "/reason-" (string ?n) ".txt") (string ?reason)))
    (var ?line (uppercase (string ?action)))
    (when (thing-p (:X ?params))
      (set ?line ($ ?line (string (:X ?params)) (string (:Y ?params)))))
    (write ($$ ?outbox "/action-" (string ?n) ".txt") ?line)
    (grid-await-frame))

  ;; grid-await-frame — poll the inbox for the next frame file.
  (function grid-await-frame {}
    (var ?inbox (setting Eidos Frames :Inbox))
    (var ?seq   (grid-seen-count))
    (var ?path  ($$ ?inbox "/frame-" (grid-pad3 ?seq) ".txt"))
    (var ?tries 0)
    (while (and (= (gone ?path) yes) (< ?tries 600))
      (tarry \@m{1})
      (set ?tries (+ ?tries 1)))
    (if (= (gone ?path) yes) nil else (grid-parse-frame (read ?path))))

  (function grid-pad3 {integer ?n}
    (if (< ?n 10)  ($$ "00" (string ?n))
     or (< ?n 100) ($$ "0"  (string ?n))
     else (string ?n)))

  (relation GridSeen :Name nil)

  (function grid-seen-count {}
    (var ?c 0)
    (with [GridSeen :Name as ?x] do (set ?c (+ ?c 1)))
    ?c)

  (function eidos-token {} (do "eidos-local"))

  ;; ── the agent ─────────────────────────────────────────────
  ;; The job is nearly empty: a turn-based world has nothing to
  ;; poll.  All the work is in the handler.

  (agent Eidos
    (function {} nil)
    (setting Eidos Psyche :Url)
    grid-handler
    (setting Eidos Psyche :Delay)
    {sensing acting})

) ;; end theory Eidos

;;; ---------------  end of file -----------------
