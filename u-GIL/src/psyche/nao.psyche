;;; *************************************************************************************
;;;  nao.psyche — the Expanse world interface
;;;
;;;  Latin expansum, "spread out."  A SoftBank NAO humanoid, 25 DOF, over
;;;  NAOqi or ROS 2.
;;;
;;;  THE SAME FOUR TUPLES AS THE EIDOS.  What differs is only what a body
;;;  has that a grid does not: eight sensory channels instead of one,
;;;  thirty-five actuations instead of seven, and homeostatic urges — a
;;;  battery that runs down, a balance that can be lost.
;;;
;;;  The job is busy here, because the physical world does not wait for the
;;;  mind to finish thinking.
;;; *************************************************************************************

(theory Expanse {2 0 0}

  "Expanse — the physical-world Psyche."

  (function expanse-register {}
    (ask (setting Observation Registrar :Url)
      { :Device     Expanse
        :Type       Psyche
        :Modality   Expanse
        :Channels   (setting Expanse NAO :Channels)
        :Needs      {power thermal balance safety connectivity}
        :Actuations (setting Expanse NAO :Capabilities) }))

  (function expanse-token {} (do "expanse-local"))

  ;; ── inbound ───────────────────────────────────────────────

  (function expanse-percept {literal ?channel literal ?data
                             variant ?address idiom ?content}
    [PERCEPT :Modality Expanse
             :Channel  ?channel
             :Address  ?address
             :Data     ?data
             :Content  ?content
             :Moment   (moment)
             :Token    (expanse-token)])

  (function expanse-sense {literal ?channel literal ?data
                           variant ?address idiom ?content}
    (when (thing-p ?content)
      (tell (setting Observation Perceiver :Url)
        (expanse-percept ?channel ?data ?address ?content))))


  ;; ── polling bookkeeping ───────────────────────────────────
  ;; State lives in the KB, not in module-level variables.

  (relation Polled :Channel nil :When 0)

  (function due-p {literal ?channel moment ?interval}
    (with [Polled :Channel = ?channel :When as ?last]
      give (>= (- (moment) ?last) ?interval)
      else yes))

  (function mark-polled {literal ?channel}
    (with [Polled ^ as ?p :Channel = ?channel]
      do (put ?p :When (moment))
      else (new Polled :Channel ?channel :When (moment))))


  ;; ── outbound ──────────────────────────────────────────────

  (function expanse-handler {?sender ?message}
    (when (= (@ ?message 1) ATTEMPT)
      (var ?action (:Action ?message))
      (var ?params (:Parameters ?message))
      (try
        (var ?raw (nao-dispatch (nao-handle) ?action ?params))
        (tell (setting Observation Perceiver :Url)
          [RESULT :Action ?action :Status succeeded :Reason ?raw
                  :Moment (moment) :Token (expanse-token)])
      learn ?err
        (tell (setting Observation Perceiver :Url)
          [RESULT :Action ?action :Status failed :Reason (string ?err)
                  :Moment (moment) :Token (expanse-token)]))))

  (relation NaoHandle :Handle nil)

  (function nao-handle {}
    (with [NaoHandle :Handle as ?h] give ?h
      else (do (var ?h (nao-open (setting Expanse NAO :Url) {}))
               (new NaoHandle :Handle ?h)
               ?h)))


  ;; ── the job: sense, then monitor ──────────────────────────

  (function expanse-job {}
    (var ?h (nao-handle))

    ;; Visual — the fastest channel that matters for navigation
    (when (due-p Visual (setting Expanse Polling :Visual))
      (expanse-sense Visual camera-frame
        ($$ (setting Expanse NAO :Url) "/camera/front")
        (nao-camera-top ?h))
      (mark-polled Visual))

    ;; Proprioceptive — where the body is, which is what the
    ;; Locater needs to know which Venue it is in
    (when (due-p Proprioceptive (setting Expanse Polling :Proprioceptive))
      (expanse-sense Proprioceptive joint-state nil (nao-joint-states ?h))
      (expanse-sense Proprioceptive imu-reading nil (nao-imu ?h))
      (mark-polled Proprioceptive))

    ;; Spatial — odometry, the Expanse analogue of an arrangement
    (when (due-p Spatial (setting Expanse Polling :Spatial))
      (expanse-sense Spatial odometry nil (nao-odom ?h))
      (mark-polled Spatial))

    ;; Auditory
    (when (due-p Auditory (setting Expanse Polling :Auditory))
      (expanse-sense Auditory audio-sample nil (nao-listen ?h {} "en-US"))
      (mark-polled Auditory))

    ;; Haptic — bumpers and head touch
    (when (due-p Haptic (setting Expanse Polling :Haptic))
      (expanse-sense Haptic bumper nil (nao-bumper-left ?h))
      (expanse-sense Haptic bumper nil (nao-bumper-right ?h))
      (mark-polled Haptic))

    ;; ── monitoring: the urges ──
    ;; A body has needs a grid does not.  These reach the mind as
    ;; URGE tuples, and the Ameliorator turns each into an Agenda
    ;; item whose telon is the need's absence.
    (when (due-p System (setting Expanse Polling :System))
      (try
        (var ?batt (nao-battery ?h))
        (var ?pct  (:Percentage ?batt))
        (when (and (thing-p ?pct)
                   (< ?pct (setting Expanse Urges :LowBattery)))
          (expanse-urge power Proprioceptive (- 1.0 ?pct)))
      learn ?e nil)

      (try
        (var ?imu (nao-imu ?h))
        (var ?tilt (+ (abs (:Pitch (:Orientation ?imu)))
                      (abs (:Roll  (:Orientation ?imu)))))
        (when (> ?tilt (setting Expanse Urges :Imbalance))
          (expanse-urge balance Proprioceptive ?tilt))
      learn ?e nil)

      (mark-polled System)))

  (function expanse-urge {literal ?need literal ?source real ?delta}
    (tell (setting Observation Perceiver :Url)
      [URGE :Need ?need :Source ?source :Delta ?delta
            :Moment (moment) :Token (expanse-token)]))

  ;; ── the agent ─────────────────────────────────────────────

  (agent Expanse
    expanse-job
    (setting Expanse Psyche :Url)
    expanse-handler
    (setting Expanse Psyche :Delay)
    {sensing acting monitoring})

) ;; end theory Expanse

;;; ---------------  end of file -----------------
