;;;
;;; eidos-psyche.theory — The Eidos Psyche
;;;
;;; The Eidos is a Psyche: the interface between a GIL mind and the
;;; ARC-AGI-3 interactive reasoning benchmark.  The world is a 64×64
;;; colored grid that changes only when the agent acts (turn-based).
;;;
;;; ARC-AGI-3 tests four capabilities:
;;;   Exploration     — discover mechanics through interaction
;;;   Modeling        — build generalizable world models from observation
;;;   Goal-setting    — identify desirable states without instructions
;;;   Planning        — map action paths and course-correct on feedback
;;;
;;; These map directly to GIL's architecture:
;;;   Perceiver       — exploration (sensing the grid)
;;;   Totality        — modeling (patterns stored as knowledge)
;;;   Coordination    — goal-setting (needs/urges drive action)
;;;   Executor        — planning and execution (attempts)
;;;
;;; The Eidos Psyche is turn-based: the job is minimal (connection
;;; health only). All real work happens in the handler — receive an
;;; ATTEMPT, dispatch the action, wrap the resulting grid as a PERCEPT.
;;;
;;; All percepts carry :Modality Eidos.
;;;


(require Eidos from "./pkg/eidos/eidos.package")


;;; ═══════════════════════════════════════════════════════════════
;;; §1  CONFIGURATION
;;; ═══════════════════════════════════════════════════════════════

(var ?psyche-url     (setting Eidos Psyche :Url))
(var ?psyche-delay   (setting Eidos Psyche :Delay))
(var ?api-url        (setting Eidos API :Url))
(var ?api-key        (setting Eidos API :Key))
(var ?grid-format    (setting Eidos Grid :Format))
(var ?perceiver-url  (setting GIL Perceiver :Url))
(var ?registrar-url  (setting GIL Registrar :Url))


;;; ═══════════════════════════════════════════════════════════════
;;; §2  GRID FORMAT
;;; ═══════════════════════════════════════════════════════════════

;;; Set the grid compression format from the daicho.
(when (/= ?grid-format nil)
  (eidos-set-grid-format ?grid-format))


;;; ═══════════════════════════════════════════════════════════════
;;; §3  DEVICE REGISTRATION
;;;
;;; The API key becomes the device token. The Registrar stores it
;;; and it accompanies every PERCEPT/RESULT/URGE tuple.
;;; ═══════════════════════════════════════════════════════════════

(var ?token
  (ask ?registrar-url
    {device     Eidos
     type       Psyche
     modality   Eidos
     channels   {Grid}
     needs      {progress efficiency}
     actuations {reset action1 action2 action3 action4 action5 action6 action7
                 up down left right interact click undo}
     credential ?api-key}))


;;; ═══════════════════════════════════════════════════════════════
;;; §4  API CONNECTION
;;;
;;; Opens HTTPS connection to the ARC-AGI-3 API.
;;; The API key is passed in the connection options for use in
;;; HTTP Authorization headers.
;;; ═══════════════════════════════════════════════════════════════

(var ?handle (eidos-open ?api-url {:ApiKey ?api-key}))


;;; ═══════════════════════════════════════════════════════════════
;;; §5  STATE
;;; ═══════════════════════════════════════════════════════════════

(var ?current-game nil)
(var ?current-grid nil)
(var ?action-count 0)
(var ?last-health-check 0)


;;; ═══════════════════════════════════════════════════════════════
;;; §6  TUPLE CONSTRUCTORS
;;; ═══════════════════════════════════════════════════════════════

(function make-percept {literal ?data variant ?address idiom ?content}
  (var ?percept
    [PERCEPT :Modality Eidos
             :Channel  Grid
             :Address  ?address
             :Data     ?data
             :Content  ?content
             :Moment   (moment)
             :Token    ?token])
  (tell ?perceiver-url ?percept)
  ?percept)

(function make-result {literal ?action literal ?status variant ?reason}
  (var ?result
    [RESULT :Action ?action
            :Status ?status
            :Reason ?reason
            :Moment (moment)
            :Token  ?token])
  (tell ?perceiver-url ?result)
  ?result)

(function make-urge {literal ?need literal ?source real ?delta}
  (var ?urge
    [URGE :Need   ?need
          :Source ?source
          :Delta  ?delta
          :Moment (moment)
          :Token  ?token])
  (tell ?perceiver-url ?urge)
  ?urge)


;;; ═══════════════════════════════════════════════════════════════
;;; §7  FRAME → PERCEPT
;;;
;;; Converts an ARC-AGI-3 frame (from eidos-wrap-frame) into a
;;; PERCEPT tuple and sends it to the Perceiver.
;;; Also generates a grid-diff percept if we have a previous grid.
;;; ═══════════════════════════════════════════════════════════════

(function frame-to-percept {idiom ?frame}

  ;;; Primary percept: the grid state
  (make-percept grid-state ?api-url ?frame)

  ;;; Delta percept: what changed since last grid
  (when (and (/= ?current-grid nil) (= (:Format ?frame) raw))
    (var ?diff (grid-diff ?current-grid (:Grid ?frame) 4096))
    (when (> (# ?diff) 0)
      (make-percept grid-delta ?api-url
        {:Changes ?diff :Count (# ?diff)})))

  ;;; Update stored grid (raw only, for diff calculation)
  (when (= (:Format ?frame) raw)
    (set ?current-grid (:Grid ?frame)))

  ;;; Game state percept: win, game-over, etc.
  (when (/= (:State ?frame) "playing")
    (make-percept game-event ?api-url
      {:State (:State ?frame)
       :LevelsCompleted (:LevelsCompleted ?frame)
       :TotalLevels (:TotalLevels ?frame)}))

  ;;; Efficiency urge: track action efficiency
  (set ?action-count (+ ?action-count 1))
  (when (and (/= (:HumanActions ?frame) nil)
             (> (:HumanActions ?frame) 0)
             (> ?action-count (* (:HumanActions ?frame) 3)))
    (make-urge efficiency Grid
      (/ ?action-count (:HumanActions ?frame))))

  ?frame)


;;; ═══════════════════════════════════════════════════════════════
;;; §8  JOB (proactive): minimal — turn-based world
;;;
;;; The grid world only changes when the agent acts, so there is
;;; nothing to poll. The job only checks connection health.
;;; ═══════════════════════════════════════════════════════════════

(function eidos-job {}

  ;;; Connection health check every 60 Moments
  (when (>= (- (moment) ?last-health-check) \@m{60})
    (var ?status (eidos-status ?handle))
    (when (= (:Status ?status) disconnected)
      (make-urge connectivity Grid 1.0))
    (set ?last-health-check (moment))))


;;; ═══════════════════════════════════════════════════════════════
;;; §9  HANDLER (reactive): actuation
;;;
;;; Receives ATTEMPTs from the Executor.
;;; Dispatches the action to the ARC API.
;;; Wraps the resulting frame as a PERCEPT.
;;; Sends a RESULT to the Perceiver.
;;; ═══════════════════════════════════════════════════════════════

(function eidos-handler {url ?sender string ?message}
  (when (= (@ ?message 1) ATTEMPT)
    (var ?action (:Action ?message))
    (var ?params (:Parameters ?message))
    (try

      ;;; Handle game start/reset specially
      (when (and (= ?action reset) (/= (:GameId ?params) nil))
        (set ?current-game (:GameId ?params))
        (set ?current-grid nil)
        (set ?action-count 0))

      ;;; Dispatch the action
      (var ?frame (eidos-dispatch ?handle ?action ?params))

      ;;; Convert the frame to percepts
      (frame-to-percept ?frame)

      ;;; Return result
      (make-result ?action succeeded
        {:State (:State ?frame)
         :LevelsCompleted (:LevelsCompleted ?frame)})

    learn ?err
      (make-result ?action failed (string ?err)))))


;;; ═══════════════════════════════════════════════════════════════
;;; §10  THE AGENT
;;; ═══════════════════════════════════════════════════════════════

(agent Eidos eidos-job ?psyche-url eidos-handler ?psyche-delay {sensing acting})


;;; ═══════════════════════════════════════════════════════════════
;;; §11  STARTUP
;;; ═══════════════════════════════════════════════════════════════

(tell user "Eidos Psyche ready — ARC-AGI-3 interface active.")
