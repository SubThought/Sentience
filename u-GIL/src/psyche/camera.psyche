;;; *************************************************************************************
;;;  camera.psyche — a bare camera device
;;;
;;;  The minimal Psyche: one channel, one percept type, no actuation.  Useful
;;;  for exercising the perception pipeline end to end with no world attached,
;;;  and as the smallest possible example of what a Psyche has to be.
;;;
;;;  A capture app sends a message carrying a URL to a ring of frames; this
;;;  takes the first frame and hands it to the Perceiver.
;;; *************************************************************************************

(theory Camera {2 0 0}

  "Camera — the minimal Psyche."

  (function camera-token {} (do "camera-local"))

  (function first-frame {variant ?msg}
    (var ?frames (:Frames ?msg))
    (if (or (null-p ?frames) (= (# ?frames) 0))
        ($$ (:FramesUrl ?msg) "0")
        ($$ (:FramesUrl ?msg) (@ ?frames 1))))

  (function frame-percept {string ?url variant ?msg}
    [PERCEPT :Modality Camera
             :Channel  Visual
             :Address  ?url
             :Data     camera-frame
             :Content  (idiom :FrameId (:FrameId ?msg)
                              :Width   (default (:Width  ?msg) 640)
                              :Height  (default (:Height ?msg) 480)
                              :Format  (default (:Format ?msg) rgb8)
                              :Objects (:Objects ?msg))
             :Moment   (moment)
             :Token    (camera-token)])

  (function camera-handler {?sender ?message}
    (try
      (tell (setting Observation Perceiver :Url)
        (frame-percept (first-frame ?message) ?message))
    learn ?err nil))

  ;; camera-ingest — direct entry, for testing without a socket.
  (function camera-ingest {variant ?message}
    (camera-handler nil ?message))

  (agent Camera
    (function {} nil)
    "locus://sol.earth.orb.local.host/mind/camera"
    camera-handler
    \@m{10}
    {sensing})

) ;; end theory Camera

;;; ---------------  end of file -----------------
