;;; *************************************************************************************
;;;  control.memory — §1 CONTROL MEMORY
;;;  Registry, Actor lifecycle, the Mind singleton, and the enumerations that
;;;  govern execution.  Reused from GIL essentially unchanged.
;;; *************************************************************************************

(extend Totality

  ;; ── Registry ──────────────────────────────────────────────
  ;; Tunable parameters.  Most live in cfg/Registry.daicho and are
  ;; read via (setting Registry ...); this relation holds any the
  ;; mind sets for itself at runtime.

  (relation Registry
    :Key    nil
    :Value  0
    :Memo   nil
  )

  ;; ── Actor ─────────────────────────────────────────────────
  ;; One row per mechanism.  :Rank is u-GIL's addition: it breaks
  ;; ties when two proposals carry equal Pulses, so selection stays
  ;; deterministic without reintroducing a score.

  (relation Actor
    :Name       nil  ; mechanism name symbol
    :Url        nil  ; service URL (nil for rules)
    :Mechanism  nil  ; agent | service | rule
    :Lifecycle  nil  ; idle | running | suspended | faulted
    :Task       nil  ; Premise task identifier
    :Cycle      0    ; nominal cycle in Moments
    :Rank       0    ; tie-break order for proposals
    :Faults     0
    :Since      0
  )

  (relation Fault
    :Actor
    :Url
    :Since
  )

  ;; ── Mind ──────────────────────────────────────────────────

  (relation Mind
    :Name        nil
    :Status      idle    ; idle | running | paused | stopped
    :Mechanisms  {}
    :Health      nil     ; healthy | degraded | critical
    :Started     0
    :Paused      0
    :Cycles      0
  )

  (function start-mind {?name}
    (new Mind :Name ?name :Status running :Started (moment))
    (observe)
    (coordinate)
    (reflect)
    (consolidate)
    (think)
    (var ?actors (with [Actor :Name as ?n] collect ?n))
    (put [Mind :Name = ?name] :Mechanisms ?actors))

  (function pause-mind {}
    (with [Mind ^ as ?mind :Status = running]
      do
      (put ?mind :Status paused :Paused (moment))
      (with [Actor :Name as ?name :Lifecycle = running :Task as ?task]
        do (stop ?task)
           (put [Actor :Name = ?name] :Lifecycle suspended))))

  (function resume-mind {}
    (with [Mind ^ as ?mind :Status = paused]
      do
      (put ?mind :Status running :Paused 0)
      (with [Actor :Name as ?name :Lifecycle = suspended :Url as ?url]
        do
        (var ?new-task (start ?name ?url))
        (put [Actor :Name = ?name] :Lifecycle running :Task ?new-task))))

  (function stop-mind {}
    (with [Mind ^ as ?mind :Status as ?s]
          (/= ?s stopped)
      do
      (with [Actor :Name as ?name :Task as ?task]
            (/= ?task nil)
        do (stop ?task)
           (put [Actor :Name = ?name] :Lifecycle idle :Task nil))
      (put ?mind :Status stopped)))

  (function mind-health {}
    (var ?total   (# (with [Actor :Name as ?n] collect ?n)))
    (var ?faulted (# (with [Actor :Lifecycle = faulted] collect 1)))
    (if (= ?faulted 0) healthy
        or (< (* 10 ?faulted) (* 3 ?total)) degraded
        else critical))


  ;; ── enumerations ──────────────────────────────────────────

  (enumeration Looping  Once 1  Repeat  Until  While )

  (relation Loop
    :M
    :Looping
    :Count
    :Tries   0
    :Watch
  )

  ;; Doings — cognitive-level action tracking.
  (enumeration Doings
    idle  0
    todo  100
    sent  150
    busy  200
    wait  300
    fail  400
    done  500
    late  600
  )

  (enumeration Mechanisms  agent  service  rule )

  (enumeration Lifecycles  idle  running  suspended  faulted )

  (enumeration Copings  pursue  promote  demote  suspend  resume  abandon  signal )

  ;; Planning — goal decomposition state on an Agenda row.
  (enumeration Planning
    todo   ; on the agenda, not yet considered
    plan   ; sub-goals being created
    busy   ; sub-goals active
    sent   ; leaf actuations dispatched
    fail   ; failed — the Compensator is needed
    done
  )

) ;; end extend Totality

;;; ---------------  end of file -----------------
