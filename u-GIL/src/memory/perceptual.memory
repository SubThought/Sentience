;;; *************************************************************************************
;;;  perceptual.memory — §4 PERCEPTUAL MEMORY
;;;
;;;  What arrives from the world, and the spatial hierarchy it builds.
;;;
;;;  Scene, Object and Trace are PERSISTED here.  In u-GIL 1.0 they were
;;;  episodic, so after a session boundary an exact recall had no Scene, the
;;;  Simulator sat out, and a whole session ran on reflex.  Provenance has to
;;;  survive a restart or the audit trail is a single session long.
;;; *************************************************************************************

(extend Totality

  ;; ── Percept — what a Psyche sends inward ──────────────────

  (relation Percept
    :M                    ; lexified monad
    :Modality             ; Eidos | Expanse
    :Channel              ; Grid | Visual | Proprioceptive | ...
    :Address   nil        ; sensor or frame address
    :Data      nil        ; grid-state | joint-state | camera-frame | ...
    :Content   nil        ; idiom — the device's own slot vocabulary
    :Moment    0
  )

  ;; ── Lexeme — a label with a stable identity ───────────────

  (relation Lexeme
    :M
    :Label
    :Moment  0
  )

  (function lexify {?label + ?totality := Actual}
    (with [Lexeme :Label = ?label :M as ?m] give ?m
      else (do (var ?r (reifier))
               (new Lexeme :M ?r :Label ?label :Moment (moment))
               ?r)))

  (function label {long ?monad}
    (with [Lexeme :M = ?monad :Label as ?l] give ?l else nil))


  ;; ── Object and Scene — the arrangement ────────────────────
  ;;
  ;; A Scene is the current perceptual field: the bottom of the
  ;; spatial hierarchy.  Imagination clones it; the Locater reads
  ;; it to decide which Venue the body is in.

  (relation Object
    :M
    :Class            ; region-9, cup, LKneePitch, ...
    :Traits   {}
    :Where    nil     ; idiom {:X :Y :Z}
    :Scene    nil
    :Moment   0
  )

  (relation Scene
    :M
    :Source   nil     ; the Percept this was captured from
    :Modality nil
    :Objects  {}
    :Venue    nil     ; which Venue this Scene was seen in (Locater sets it)
    :Moment   0
  )

  ;; scene-of — read a Scene back as a list of Object idioms.
  (function scene-of {long ?scene}
    (var ?objs {})
    (with [Scene :M = ?scene :Objects as ?ors]
      do (for ?or in ?ors
           (with [Object :M = ?or :Class as ?cl :Where as ?wh :Traits as ?tr]
             do (set ?objs (append ?objs
                  (idiom :M ?or :Class ?cl :Where ?wh :Traits ?tr))))))
    ?objs)


  ;; ── the spatial hierarchy ─────────────────────────────────
  ;;
  ;; Seven levels, Scene at the bottom and Map at the top.  The
  ;; SAME grammar serves both worlds; only the contents differ,
  ;; and the contents are learned.
  ;;
  ;;    Level   Eidos                     Expanse
  ;;    ─────   ───────────────────────   ─────────────────
  ;;    Map     the whole game            the site
  ;;    Region  a quadrant of a level      a building
  ;;    Area    a corridor system          a floor
  ;;    Place   an arrangement             a spot: by the door
  ;;    Locale  a chamber of the maze      the kitchen
  ;;    Venue   the board                  the room
  ;;    Scene   one frame's regions        one camera field
  ;;
  ;; Every level is a Scheme of the corresponding relation, so
  ;; activation flows up and down the hierarchy exactly as it
  ;; flows through any other scheme.  Locality is a Spot; a
  ;; Landmark is what lets a Venue be recognised again.

  (template Venue                    ; a navigable bounded space
    { :Scenes     {}                 ; arguments — the Scenes seen here
      :Landmarks  {} }               ;            what identifies it
    { :Locale     nil })             ; referents — its container

  (template Locale                   ; a bounded subspace with a landmark
    { :Venues     {}
      :Landmarks  {} }
    { :Place      nil })

  (template Place                    ; a recognisable location within a Locale
    { :Locales    {}
      :Signature  {} }               ; the fingerprint that recurs
    { :Area       nil })

  (template Area                     ; a functional grouping of Places
    { :Places     {} }
    { :Region     nil })

  (template Region                   ; a cohesive grouping of Areas
    { :Areas      {} }
    { :Map        nil })

  (template MapLevel                 ; the global environment
    { :Regions    {}
      :Modality   nil })

  ;; Spot — a coordinate binding an Object to a level.
  (template Spot
    { :M      nil
      :Level  nil     ; Scene | Venue | Locale | Place | Area | Region | Map
      :X      0
      :Y      0
      :Z      0 })

  ;; Landmark — a perceptual invariant that identifies a level.
  ;; In Eidos: a static cluster's normalised token.  In Expanse:
  ;; a recognised object.  Same relation, different detector.
  (template Landmark
    { :M          nil
      :Level      nil
      :Signature  {}
      :Confidence 0
      :Moment     0 })


  ;; ── Trace — the audit trail ───────────────────────────────
  ;; Persisted.  Every observation records its stages, so the
  ;; portal renders the same rows the mind acted on.

  (relation Trace
    :M
    :Modality
    :Channel
    :Data
    :Traits    {}
    :Outcome   nil    ; new | recalled
    :Score     0      ; the match score that decided it
    :Scene     nil
    :Stages    {}
    :Moment    0
  )

) ;; end extend Totality

;;; ---------------  end of file -----------------
