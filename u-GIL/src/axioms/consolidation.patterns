;;; *************************************************************************************
;;;  consolidation.patterns — Consolidation component manifest.
;;;
;;;  Forgetting and automaticity.  Forgetting is not an optimisation; it is
;;;  part of the epistemology — a memory that never forgets eventually
;;;  poisons you.  Automaticity is the horizon fix: a proven sequence is
;;;  compressed into ONE Action with a Series of Goals, selectable in a
;;;  single decision.
;;; *************************************************************************************

(theory Consolidation {2 0 0}

  "Consolidation — forgetting and automaticity."

  ;; Compression — a permanent audit record of a consolidation event.
  (relation Compression
    :Sources  {}   ; source scheme reifiers that were merged
    :Result   nil  ; the merged or representative scheme
    :Kind     nil  ; automaticity | similarity | staleness
    :Moment   0
  )

  (require  Consolidation  from  "../pattern/forgetting.pattern"  or abort)
  (require  Consolidation  from  "../pattern/automating.pattern"  or abort)

  (function consolidate {}
    "Start all consolidation mechanisms."
    (trace "[Consolidation] starting")
    (map { Amneator Automator }
         (given {?m} (call start ?m)))
    (trace "[Consolidation] running")
    consolidating)

) ;; end theory Consolidation

;;; ---------------  end of file -----------------
