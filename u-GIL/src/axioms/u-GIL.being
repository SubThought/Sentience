;;; *************************************************************************************
;;;
;;;  u-GIL.being — micro Generally Intelligent Learner
;;;
;;;  Entry point.  Requires the Totality and the four components, opens the
;;;  lore, states the Self-Actualization problem, and starts the mind.
;;;
;;;      ┌──────────────────────────────────────────────────────────┐
;;;      │  Observation   Coordination   Reflection   Consolidation │
;;;      │       │              │             │              │      │
;;;      │       └──────────────┴─── Totality ┴──────────────┘      │
;;;      └──────────────────────────────────────────────────────────┘
;;;                                  │
;;;                          Psyche → Device → World
;;;
;;;  Two worlds, one psyche interface:
;;;      Eidos    — the ARC-AGI-3 grid           (src/psyche/grid.psyche)
;;;      Expanse  — a NAO humanoid               (src/psyche/nao.psyche)
;;;
;;;  Decisioning is activation strength in Desired reality.  Proposers enable
;;;  their candidate act; gates impede; the Deliberator selects the most
;;;  activated; Cronos decays what nobody re-endorses.
;;;
;;; *************************************************************************************

(theory u-GIL {2 0 0}

  "u-GIL — a parsimonious instance of the Piagetian Modeler."

  ;;; ── configuration ─────────────────────────────────────────
  (grok "./cfg/u-GIL.daicho")
  (grok "./cfg/Registry.daicho")
  (grok "./cfg/Eidos.daicho")
  (grok "./cfg/Expanse.daicho")

  ;;; ── memory, then the four components ──────────────────────
  (require  Totality       from  "./src/axioms/u-GIL.totality"        or abort)
  (require  Observation    from  "./src/axioms/observation.patterns"  or abort)
  (require  Coordination   from  "./src/axioms/coordination.patterns" or abort)
  (require  Reflection     from  "./src/axioms/reflection.patterns"   or abort)
  (require  Consolidation  from  "./src/axioms/consolidation.patterns" or abort)

  ;;; ── the worlds ────────────────────────────────────────────
  (require  Eidos    from  "./src/psyche/grid.psyche"    or abort)
  (require  Expanse  from  "./src/psyche/nao.psyche"     or abort)

  ;;; ── the audit surface ─────────────────────────────────────
  (require  Portal   from  "./src/portal/render.theory"  or abort)


  (use (lore url (setting u-GIL Totality :Url))

    (domain Wisdom

      (problem Self-Actualization
        state (assume Novelty :Facts [I_AM])))

    (start-mind u-GIL)

  ) ;; end use

) ;; end theory u-GIL

;;; ---------------  end of file -----------------
