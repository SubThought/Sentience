;;; *************************************************************************************
;;;
;;;  u-GIL.totality — the shared knowledge base.
;;;
;;;  Holds the Relationships enumeration (common to every area), the R/L/V
;;;  shorthands, the tier map, the Merging bootstraps, and requires the six
;;;  memory areas in dependency order.
;;;
;;;  Roughly 90% of this is GIL's Totality, reused verbatim.  The divergence
;;;  between the two systems lives in src/pattern/, not here.
;;;
;;; *************************************************************************************

(theory Totality {2 0 0}

  "Shared knowledge base for u-GIL."

  ;; ═══════════════════════════════════════════════════════════
  ;; RELATIONSHIPS
  ;;
  ;; Loaded before any area so every area and every pattern can
  ;; reference relation numbers and zone predicates without a
  ;; load-order dependency.
  ;; ═══════════════════════════════════════════════════════════

  (enumeration Relationships

    ;; ── UTILITY ZONE  (0 – 99,999) ──────────────────────────
    None          0         ; absent reifier — default for unset :M
    Awareness     100       ; ground viewpoint
    Relation      200       ; self-describing
    Schema        300       ; template for creating schemes
    Resilience    400       ; coping case

    Once          10000
    Repeat        10100
    Until         10200
    While         10300

    ;; ── SLOTS ZONE  (100,000 – 199,999) ─────────────────────
    :Slots        100000
    :Context      100100    ; Unison of preconditions
    :Goals        100200    ; Series of actuations or sub-actions
    :Loop         100300
    :Result       100400    ; Unison of postconditions

    :Premises     110000
    :Known        110100
    :Lemmas       110200
    :Proof        110300
    :Theorems     110400

    Viewpoint     120000

    ;; ── PRECONCEPTUAL ZONE  (200,000 – 799,999) ─────────────

    ;; Observables
    Feature       200000
    Result        200100
    Percept       200200
    Urge          200300

    ;; Images — spatial schemas (Lakoff & Johnson)
    Above         210000
    Across        210100
    Apart         210200
    Behind        210300
    Beside        210400
    Boundary      210500
    Contact       210600
    Container     210700
    Path          210800
    Together      210900

    ;; Localization — the seven spatial levels, Scene at the
    ;; bottom, Map at the top.  Shared by BOTH worlds: what
    ;; fills them is learned per device.
    Scene         220000
    Venue         220100
    Locale        220200
    Place         220300
    Area          220400
    Region        220500
    Map           220600

    ;; Simple
    Genus         230000
    Grounding     230100
    Member        230200
    Tandem        230300
    Slot          230400
    Swap          230500
    Symbolism     230600

    ;; Vertical
    Different     240000
    Equivalent    240100
    Identical     240200
    Incompatible  240300
    Similar       240400

    ;; Gates
    Category      250000
    Choice        250100
    League        250200
    Ordering      250300
    Unison        250400
    Series        250500

    ;; Preconceptual derivatives
    Sign          260000
    Symbol        260100
    Entity        260200
    Utterance     260300
    Route         260350     ; spatial Utterance — waypoints to a destination
    Situation     260400
    Event         260500
    Episode       260600
    Dream         260700
    Objective     260800
    Actuation     260900
    Action        261000
    Distinction   261100

    ;; Structures
    Idea          270000
    Scenario      270100
    Prototype     270200
    Class         270300

    ;; ── CONCEPTUAL ZONE  (800,000 – 999,999) ────────────────
    Concept       800000

    Hypothesis    810000
    Causes        810100
    Implies       810200
    Refuter       810300
    Metaphor      810400
    Analogy       810500
    Statement     810600
    Frame         810700
    Operation     810900
    Reason        811000
    Believes      811100
    Desires       811200
    Intends       811300
    Obstacle      811400
    Contradiction 811500
    Gap           811600
    Lesson        811800
    Theory        812100
    Prediction    812400
    Experiment    812500

    ;; ── AUTOGENOUS ZONE  (1,000,000+) ───────────────────────
    Autogenous    1000000   ; self-created relations start here
  )


  ;; ── shorthands ────────────────────────────────────────────

  ;; R — relation reifier by name.  (R Causes) -> the number.
  (function R {literal ?name} (enum Relationships ?name))

  ;; L — lexeme by label.  Dynamic where R is static.
  (function L {?label + ?totality := Actual} (lexify ?label ?totality))

  ;; V — viewpoint accessor, numeric or symbolic.
  (function V {atom ?what}
    (case (taxon ?what)
      of number  ?what
      of literal (L ?what)
      else (signal Failure :Name InvalidViewpoint
                   :Text ($ "viewpoint " ?what " not found."))))


  ;; ── zone predicates ───────────────────────────────────────

  (function relationship-p {?v}
    (and (taxon-p ?v number) (>= ?v 0) (< ?v (R Autogenous))))

  (function monad-p {?v}
    (and (taxon-p ?v long) (>= (abs ?v) (R Autogenous))))

  (function preconceptual-relation-p {long ?relation}
    (and (>= ?relation 200000) (< ?relation (R Concept))))

  (function conceptual-relation-p {long ?relation}
    (>= ?relation (R Concept)))

  ;; spatial-relation-p — is this one of the seven levels?
  ;; Used by the Locater, Mapper and Navigator to decide which
  ;; tier of the hierarchy they are working at.
  (function spatial-relation-p {long ?relation}
    (and (>= ?relation (R Scene)) (<= ?relation (R Map))))

  ;; spatial-above / spatial-below — the level one step up or
  ;; down the hierarchy.  Levels are 100 apart by construction.
  (function spatial-above {long ?relation}
    (if (>= ?relation (R Map)) nil else (+ ?relation 100)))

  (function spatial-below {long ?relation}
    (if (<= ?relation (R Scene)) nil else (- ?relation 100)))


  ;; ── heterarchies and tiers ────────────────────────────────
  ;;
  ;; Maps each abstraction tier to its Relationship range and its
  ;; Glue :Z, so the abstraction gradient is inspectable.

  (enumeration Heterarchies
    percept    1
    feature    2
    entity     3
    situation  4
    event      5
    episode    6
    action     7
    concept    8
    operation  9
  )

  (relation Tier
    :Heterarchy
    :Z     0
    :Low   0
    :High  0
  )

  (posit  [Tier :Heterarchy percept   :Z 1'000'000 :Low 200000 :High 200199]
          [Tier :Heterarchy feature   :Z 2'000'000 :Low 200200 :High 260199]
          [Tier :Heterarchy entity    :Z 3'000'000 :Low 260200 :High 260399]
          [Tier :Heterarchy situation :Z 4'000'000 :Low 260400 :High 260499]
          [Tier :Heterarchy event     :Z 5'000'000 :Low 260500 :High 260599]
          [Tier :Heterarchy episode   :Z 6'000'000 :Low 260600 :High 260999]
          [Tier :Heterarchy action    :Z 7'000'000 :Low 261000 :High 799999]
          [Tier :Heterarchy concept   :Z 8'000'000 :Low 800000 :High 810899]
          [Tier :Heterarchy operation :Z 9'000'000 :Low 810900 :High 999999])

  (function tier-for {long ?relation}
    (with [Tier :Low as ?lo :High as ?hi :Z as ?z]
          (and (>= ?relation ?lo) (<= ?relation ?hi))
      give ?z else 0))


  ;; ── merges ────────────────────────────────────────────────
  ;;
  ;; How argument activations combine to activate a reifier.

  (enumeration Merge
    ONE   ; the sole argument activates the reifier
    PASS  ; activation passes through unconditionally
    NOT   ; activation is negated
    AND   ; all arguments must be active concurrently
    SEQ   ; arguments must activate in sequence
    OR    ; any argument fires the reifier
    NOR   ; fires only when no arguments are active
    VOTE  ; fires when a quorum of arguments is active
  )

  (relation Merging
    :R
    :Merge
  )

  (new Merging :R (L Category)  :Merge (L Or))
  (new Merging :R (L Choice)    :Merge (L One))
  (new Merging :R (L League)    :Merge (L Vote))
  (new Merging :R (L Ordering)  :Merge (L Or))
  (new Merging :R (L Unison)    :Merge (L And))
  (new Merging :R (L Series)    :Merge (L Seq))
  (new Merging :R (L Tandem)    :Merge (L Seq))
  (new Merging :R (L Slot)      :Merge (L And))
  (new Merging :R (L Idea)      :Merge (L And))
  (new Merging :R (L Event)     :Merge (L And))
  (new Merging :R (L Utterance) :Merge (L Seq))
  (new Merging :R (L Route)     :Merge (L Seq))

  ;; An Action's :Context is a Unison of preconditions: every one
  ;; must hold before the Action can fire.  Without this row the
  ;; default is PASS and a single satisfied precondition would be
  ;; enough — the commonest way to get an eager, wrong reflex.
  (new Merging :R (L Action)    :Merge (L And))

  ;; The spatial levels are containment groupings: any member
  ;; being active makes the container relevant.
  (new Merging :R (L Venue)     :Merge (L Or))
  (new Merging :R (L Locale)    :Merge (L Or))
  (new Merging :R (L Place)     :Merge (L Or))
  (new Merging :R (L Area)      :Merge (L Or))
  (new Merging :R (L Region)    :Merge (L Or))
  (new Merging :R (L Map)       :Merge (L Or))


  ;; ═══════════════════════════════════════════════════════════
  ;; MEMORY AREAS — dependency order
  ;;
  ;;   control     — Registry, Actor, Mind; used by all
  ;;   ontological — Scheme machinery; depends on the enum above
  ;;   perceptual  — Lexeme, Scene, Object
  ;;   associative — Case, Trait (the inverted index)
  ;;   imaginative — Canvas through Route
  ;;   activative  — Activation, Agenda, Attempt, Glue
  ;; ═══════════════════════════════════════════════════════════

  (require  Totality  from  "../memory/control.memory"      or abort)
  (require  Totality  from  "../memory/ontological.memory"  or abort)
  (require  Totality  from  "../memory/perceptual.memory"   or abort)
  (require  Totality  from  "../memory/associative.memory"  or abort)
  (require  Totality  from  "../memory/imaginative.memory"  or abort)
  (require  Totality  from  "../memory/activative.memory"   or abort)

) ;; end theory Totality

;;; ---------------  end of file -----------------
