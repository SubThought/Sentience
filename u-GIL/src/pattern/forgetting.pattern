;;; *************************************************************************************
;;;  forgetting.pattern — the Amneator (Consolidation)
;;;
;;;  Forgetting is not an optimisation.  It is part of the epistemology.
;;;
;;;  u-GIL 1.0 learned this the hard way: a stale landmark survived in memory,
;;;  passed a vacuous re-check, and pulled thirty-seven deliveries toward a
;;;  target that was no longer on the board.  A memory that never forgets
;;;  eventually poisons you.
;;;
;;;  Two passes, plus reclamation of settled cognitive debris.
;;; *************************************************************************************

(extend Consolidation

  (agent Amneator
    (function {}
      (var ?now  (moment))
      (var ?iwin (setting Registry Forgetting :ImmediateDiscardWindow))
      (var ?ewin (setting Registry Forgetting :EventualDiscardWindow))
      (var ?low  (setting Registry Forgetting :LowUsageThreshold))

      ;; Pass 1 — recent, never used.  It was a guess and nothing
      ;; came of it.
      (with [Activation ^ as ?a :Pulses = 0 :EnabledUntil as ?eu :M as ?r]
            [Usage :M = ?r :Count = 0]
            (< (- ?now ?eu) ?iwin)
        do (old ?a))

      ;; Pass 2 — old, barely used.  It may once have been true;
      ;; it is no longer earning its place.
      (with [Activation ^ as ?a :Pulses = 0 :EnabledUntil as ?eu :M as ?r]
            [Usage :M = ?r :Count as ?uc]
            (and (> (- ?now ?eu) ?ewin) (< ?uc ?low))
        do (old ?a))

      ;; Decisively disconfirmed hypotheses.
      (with [Causes ^ as ?c :Support = disconfirmed :Confidence = 0]
        do (old ?c))

      ;; Predictions whose hypothesis has settled.
      (with [Prediction ^ as ?p :Outcome as ?out :Hypothesis as ?hyp]
            (/= ?out pending)
            [Causes :M = ?hyp :Support as ?sup]
            (/= ?sup open)
        do (old ?p))

      ;; Closed Problems that produced a Lesson — the lesson is
      ;; the residue worth keeping, not the problem.
      (with [Problem ^ as ?pr :M as ?pid :Status = done]
            [Lesson :Problem = ?pid]
        do (old ?pr))

      ;; Stale landmarks.  A Venue whose landmarks have not been
      ;; re-perceived in a long while should stop being
      ;; recognisable, or the mind navigates toward a room that
      ;; is not there.
      (with [Landmark ^ as ?lm :Moment as ?t]
            (> (- ?now ?t) ?ewin)
        do (old ?lm)))

    "locus://sol.earth.orb.local.host/mind/amneator"
    (function {?sender ?msg} told)
    \@m{5000})

) ;; end extend Consolidation

;;; ---------------  end of file -----------------
