;;; *************************************************************************************
;;;  automating.pattern — the Automator (Consolidation)
;;;
;;;  THE HORIZON FIX, in its second form.
;;;
;;;  When two Actions succeed reliably in sequence, they are compressed into
;;;  ONE composite Action: the first's :Context, both sets of :Goals in
;;;  order, the second's :Result.  The constituents are preserved — the
;;;  composite is an addition, not a replacement.
;;;
;;;  What that buys: a forty-step excursion, once walked, becomes one Action
;;;  with a Series of forty Goals — selectable in a SINGLE decision, and
;;;  arriving with its Result unknown so the Explorer will test it.
;;;
;;;  A child who reliably does reach, grasp, lift eventually just picks
;;;  things up.
;;; *************************************************************************************

(extend Consolidation

  (agent Automator
    (function {}
      (var ?count (setting Registry Automaticity :CountThreshold))
      (var ?rel   (setting Registry Automaticity :ReliabilityThreshold))
      (var ?window (setting Registry Automaticity :GeneticWindow))

      ;; A Tandem of two Actions, both reliable, seen often enough.
      (with [Tandem :Prior as ?a :Later as ?b]
            [Case :Content as ?tandem :Count as ?n]
            (>= ?n ?count)
            [Utility :M = ?a :Attempts as ?aa :Successes as ?as]
            [Utility :M = ?b :Attempts as ?ba :Successes as ?bs]
            (and (> ?aa 0) (> ?ba 0))
            (and (>= (/ ?as ?aa) ?rel) (>= (/ ?bs ?ba) ?rel))
        do
        (with [Action :M = ?a :Context as ?actx :Goals as ?agoals]
              [Action :M = ?b :Goals as ?bgoals]
              [Scheme :M = ?b :E as ?bres]
          do
          ;; do not breed the same composite twice
          (var ?goals (append ?agoals ?bgoals))
          (unless (any [Action :Goals as ?g] (= ?g ?goals))
            (var ?composite
              (schema Action { :Context ?actx
                               :Goals   ?goals
                               :Loop    (R Once)
                               :For     (L Life)
                               :Result  {} }))   ; unknown: the Explorer will test it
            (new Compression :Sources {?a ?b} :Result ?composite
                             :Kind automaticity :Moment (moment))
            (new Origin :M ?composite :Provenance Made :Mechanism Automator
                        :Source ?a :Moment (moment))
            (trace ($ "[Automator] composed " (string ?a) " + " (string ?b)))))))

    "locus://sol.earth.orb.local.host/mind/automator"
    (function {?sender ?msg} told)
    \@m{10000})

) ;; end extend Consolidation

;;; ---------------  end of file -----------------
