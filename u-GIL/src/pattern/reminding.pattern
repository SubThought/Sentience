;;; *************************************************************************************
;;;  reminding.pattern — associative retrieval (Observation)
;;;
;;;  The Matcher, the Storer and the Lexer as services.  All three are thin:
;;;  the real work is matcher-find in associative.memory, which narrows
;;;  through the inverted Trait index and then scores with the built-in
;;;  similarity intrinsic.
;;;
;;;  The point of exposing them as services is that the CALLER chooses the
;;;  bar.  Event identity demands 1.0; percept assimilation runs at the
;;;  configured score.  One global threshold is what collapsed distinct
;;;  positions into a single Case in 1.0.
;;; *************************************************************************************

(extend Observation

  ;; ── MATCHER ───────────────────────────────────────────────

  (service Matcher
    (setting Observation Matcher :Url)
    (function {?sender ?request}
      (var ?results
        (matcher-find
          :traits   (:Traits   ?request)
          :relation (:R        ?request)
          :minscore (default (:MinScore ?request) (setting u-GIL Matcher :PerceptScore))
          :limit    (default (:Limit    ?request) (setting u-GIL Matcher :Limit))
          :return   (default (:Return   ?request) Content)
          :comparer (default (:Comparer ?request) nil)))
      (send ?sender {(self) [MATCHED :Results ?results :Moment (moment)]})
      told))

  ;; recognise — convenience: the single best match at a bar, or nil.
  (function recognise {list ?traits literal ?relation + ?minscore := nil}
    (var ?bar (default ?minscore (setting u-GIL Matcher :PerceptScore)))
    (var ?hits (matcher-find :traits ?traits :relation ?relation
                             :minscore ?bar :limit 1 :return Content))
    (if (more-p ?hits) (:Content (first ?hits)) else nil))

  ;; identical — the exact-identity path.  Used for Events and for
  ;; recognising a Venue you have genuinely been in before.
  (function identical {list ?traits literal ?relation}
    (recognise ?traits ?relation (setting u-GIL Matcher :IdentityScore)))


  ;; ── LEXER ─────────────────────────────────────────────────

  (service Lexer
    (setting Observation Lexer :Url)
    (function {?sender ?request}
      (var ?m (lexify (:Label ?request)))
      (send ?sender {(self) [LEXIFIED :M ?m]})
      told))


  ;; ── STORER ────────────────────────────────────────────────

  (service Storer
    (setting Observation Storer :Url)
    (function {?sender ?request}
      (var ?case (store (:Content ?request) (:R ?request) (:Traits ?request)))
      (send ?sender {(self) [STORED :Case ?case]})
      told))

  ;; ── SCENER ────────────────────────────────────────────────
  ;; capture-scene lives in observing.pattern; this is the agent
  ;; that keeps Scenes tied to the Venue the Locater assigns.

  (agent Scener
    (function {}
      (with [Scene ^ as ?s :M as ?m :Venue = nil]
            [Activation :M = ?m :Reality = Observed :Pulses > 0]
        do
        (var ?venue (current-venue))
        (when (thing-p ?venue) (put ?s :Venue ?venue))))
    (setting Observation Scener :Url)
    (function {?sender ?msg} told)
    \@m{2})

) ;; end extend Observation

;;; ---------------  end of file -----------------
