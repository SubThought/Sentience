;;; *************************************************************************************
;;;  reacting.pattern — reflex and case-based proposal (Coordination)
;;;
;;;  Two proposers.  Neither decides anything: both enable a Trial in
;;;  Desired and let the Deliberator weigh the activation.
;;;
;;;    KACE     — this Action produced progress from THIS context before.
;;;    REACTOR  — this Action is globally reliable.
;;;
;;;  Kace outranks Reactor on a tie because direct evidence from here beats
;;;  a general habit.  But if the Simulator and the Navigator both also
;;;  endorse the Reactor's act, their combined Pulses carry it — which is
;;;  the point of additive evidence.
;;; *************************************************************************************

(extend Coordination

  ;; ── KACE — case-based proposal ────────────────────────────

  (rule Kace
    memo "Propose an Action that produced progress from this exact context."
    domain Wisdom
    salience 9000
    with [Action :M as ?act :Context as ?ctx]
         (every ?p in ?ctx (is-active ?p Observed))
         [Utility :M = ?act :Successes as ?suc]
         (> ?suc 0)
         (notany [Trial :Action = ?act :Doing = idle])
    do
      (var ?t (schema Trial { :Action ?act :Basis Kace :Dream nil
                              :Doing idle :Moment (moment) }))
      (enable :reifiers {?t} :moment (moment) :reality Desired))


  ;; ── REACTOR — reliable reflex ─────────────────────────────
  ;;
  ;; Reliability is Successes over Attempts, from the Utility
  ;; ledger the Regulator maintains.  Note the guard on :Attempts:
  ;; in u-GIL 1.0 the world's HUD ticked on every action, so every
  ;; act looked "reliable" and the reflex swallowed exploration.
  ;; Reliability is measured against SUCCESS, not against change.

  (rule Reactor
    memo "Propose a globally reliable Action whose preconditions hold."
    domain Wisdom
    salience 8900
    with [Action :M as ?act :Context as ?ctx :Goals as ?goals]
         (every ?p in ?ctx (is-active ?p Observed))
         (every ?g in ?goals (with [Actuation :M = ?g] give yes else no))
         [Utility :M = ?act :Attempts as ?att :Successes as ?suc]
         (> ?att 0)
         (>= (/ ?suc ?att) (setting Registry Reaction :ReliabilityThreshold))
         (notany [Trial :Action = ?act :Doing = idle])
    do
      (var ?t (schema Trial { :Action ?act :Basis Reactor :Dream nil
                              :Doing idle :Moment (moment) }))
      (enable :reifiers {?t} :moment (moment) :reality Desired))


  ;; ── HOLDER — do nothing, on purpose ───────────────────────
  ;;
  ;; In a world whose own dynamics move things regardless of what
  ;; the mind does, acting can be worse than waiting.  Discovered
  ;; rather than declared: the null action is the actuation whose
  ;; Actions have Results but no consistent displacement.

  (rule Holder
    memo "In an untrustable world, propose the discovered null action."
    domain Wisdom
    salience 100
    with [Actuation :M as ?null]
         (null-action-p ?null)
         [Action :M as ?act :Goals as ?goals]
         (in ?null ?goals)
         (notany [Trial :Action = ?act :Doing = idle])
    do
      (var ?t (schema Trial { :Action ?act :Basis Holder :Dream nil
                              :Doing idle :Moment (moment) }))
      (enable :reifiers {?t} :moment (moment) :reality Desired))

  ;; null-action-p — has this actuation ever moved anything the
  ;; mind controls?
  (function null-action-p {long ?actuation}
    (var ?moved no)
    (with [Action :M as ?a :Goals as ?goals]
          (in ?actuation ?goals)
          [Scheme :M = ?a :E as ?res]
          (more-p ?res)
      do (set ?moved yes))
    (not ?moved))

) ;; end extend Coordination

;;; ---------------  end of file -----------------
