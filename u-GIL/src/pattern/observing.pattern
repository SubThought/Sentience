;;; *************************************************************************************
;;;  observing.pattern — the perception pipeline (Observation)
;;;
;;;      Psyche -> Perceiver -> Detector -> Matcher -> [Lexer -> Storer] -> Scener -> Activator
;;;
;;;  Miss  -> ASSIMILATE: mint a reifier, store a Case, the ontology grows.
;;;  Hit   -> ACCOMMODATE: reinforce the Case, spread activation.
;;;
;;;  Detection is the ONLY modality-specific stage.  Everything after it
;;;  works on the trait set alone and cannot tell a grid from a knee.
;;; *************************************************************************************

(extend Observation

  ;; ── DETECTOR — the one world-specific stage ───────────────
  ;; Dispatch on :Data.  Add a world by adding a clause here and
  ;; nothing else changes.

  (service Detector
    (setting Observation Detector :Url)
    (function {?sender ?percept}
      (var ?data    (:Data ?percept))
      (var ?content (:Content ?percept))
      (send ?sender
        (case ?data
          of grid-state    (detect-grid    ?content)
          of grid-delta    (detect-delta   ?content)
          of camera-frame  (detect-frame   ?content)
          of joint-state   (detect-joints  ?content)
          of imu-reading   (detect-imu     ?content)
          of odometry      (detect-odom    ?content)
          else             (detect-generic ?content)))))


  ;; ── PERCEIVER — the orchestrator ──────────────────────────
  ;;
  ;; Every observation writes a Trace, so perception is auditable.
  ;; The match SCORE is recorded, not just the verdict: a caller
  ;; that needs exact identity can demand 1.0 while assimilation
  ;; runs at the configured bar.

  (function perceive {variant ?percept}
    (var ?stages {})

    ;; detect
    (var ?traits (detect ?percept))
    (set ?stages (append ?stages
      (idiom :Stage detector :Note ($ (string (# ?traits)) " traits"))))

    ;; match — graded
    (var ?bar (setting u-GIL Matcher :PerceptScore))
    (var ?hits (matcher-find :traits ?traits :relation Percept
                             :minscore ?bar :limit 1 :return Content))
    (var ?monad nil)
    (var ?score 0)
    (var ?outcome new)

    (if (more-p ?hits)
      ;; ── ACCOMMODATION: this experience is known ──
      (do
        (set ?monad (:Content (first ?hits)))
        (set ?score (:Score   (first ?hits)))
        (set ?outcome recalled)
        (with [Case :Content = ?monad :Case as ?c] do (reinforce ?c))
        (set ?stages (append ?stages
          (idiom :Stage matcher :Note ($ "recalled at " (string ?score))))))
    else
      ;; ── ASSIMILATION: mint identity, file the case ──
      (do
        (set ?monad (lexify-percept ?percept ?traits))
        (set ?stages (append ?stages
          (idiom :Stage lexer :Note ($ "minted " (string ?monad)))))
        (store ?monad Percept ?traits)
        (set ?stages (append ?stages (idiom :Stage storer :Note "case stored")))))

    ;; the percept is now true
    (enable :reifiers {?monad} :moment (moment) :reality Observed)
    (set ?stages (append ?stages (idiom :Stage activator :Note "enabled")))

    ;; capture the arrangement — the bottom of the spatial hierarchy
    (var ?scene (capture-scene ?monad ?percept))
    (when (thing-p ?scene)
      (set ?stages (append ?stages
        (idiom :Stage scener :Note ($ "scene " (string ?scene))))))

    ;; the audit row — PERSISTED, so provenance crosses sessions
    (var ?trace
      (new Trace :M       (reifier)
                 :Modality (:Modality ?percept)
                 :Channel  (:Channel ?percept)
                 :Data     (:Data ?percept)
                 :Traits   ?traits
                 :Outcome  ?outcome
                 :Score    ?score
                 :Scene    ?scene
                 :Stages   ?stages
                 :Moment   (moment)))
    ?trace)


  ;; lexify-percept — mint the scheme a new experience names.
  (function lexify-percept {variant ?percept list ?traits}
    (var ?m (make :R (R Percept) :A ?traits))
    (new Percept :M ?m
                 :Modality (:Modality ?percept)
                 :Channel  (:Channel  ?percept)
                 :Address  (:Address  ?percept)
                 :Data     (:Data     ?percept)
                 :Content  (:Content  ?percept)
                 :Moment   (moment))
    ?m)


  ;; ── SCENER — perceptual memory ────────────────────────────
  ;; The arrangement imagination later clones, and the raw
  ;; material the Locater turns into a Venue.

  (function capture-scene {long ?source variant ?percept}
    (var ?objects (scene-objects ?percept))
    (if (= (# ?objects) 0)
      nil
    else
      (do
        (var ?scene (reifier))
        (var ?ors {})
        (for ?o in ?objects
          (var ?or (reifier))
          (new Object :M ?or :Class (:Class ?o) :Traits (:Traits ?o)
                      :Where (:Where ?o) :Scene ?scene :Moment (moment))
          (set ?ors (append ?ors ?or)))
        (new Scene :M ?scene :Source ?source
                   :Modality (:Modality ?percept)
                   :Objects ?ors :Venue nil :Moment (moment))
        (enable :reifiers {?scene} :moment (moment) :reality Observed)
        ?scene)))


  ;; ── ROUTER — dispatch an inbound tuple by its head ────────

  (function observe-tuple {variant ?tuple}
    (case (@ ?tuple 1)
      of PERCEPT  (perceive ?tuple)
      of RESULT   (perceive-result ?tuple)
      of URGE     (perceive-urge ?tuple)
      else        nil))

  ;; Urges and Results skip detection: they are lexified directly.
  (function perceive-urge {variant ?urge}
    (var ?m (schema Objective { :Drive life :Need (:Need ?urge)
                                :Urgency (:Delta ?urge)
                                :Context {} :Goals {} :Result {} }))
    (enable :reifiers {?m} :moment (moment) :reality Desired)
    ?m)

  (function perceive-result {variant ?result}
    ;; the Action-Correlator settles it; this only records arrival
    (var ?m (reifier))
    (new Observable :M ?m :Modality (:Modality ?result)
                    :Data (:Status ?result) :Moment (moment))
    (enable :reifiers {?m} :moment (moment) :reality Observed)
    ?m)


  ;; ── the Perceiver agent ───────────────────────────────────

  (agent Perceiver
    (function {}
      (bind (peep (self)) 1 ?any 2 ?envelope)
      (when ?any
        (bind ?envelope 1 ?sender 2 ?payload)
        (observe-tuple ?payload)))
    (setting Observation Perceiver :Url)
    (function {?sender ?msg} (send (self) {?sender ?msg}))
    \@m{1}
    {perceiving})

) ;; end extend Observation

;;; ---------------  end of file -----------------
