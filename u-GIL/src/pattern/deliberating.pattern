;;; *************************************************************************************
;;;  deliberating.pattern — the decision (Coordination)
;;;
;;;  SELECTION IS ACTIVATION STRENGTH IN DESIRED REALITY.
;;;
;;;  There is no ranking procedure and no score table.  Proposers enable
;;;  their candidate Trial in Desired; when several converge on the same
;;;  act, Pulses ACCUMULATE on the same monad.  The Deliberator takes the
;;;  most activated, records every candidate, and hands it to the Executor.
;;;
;;;  Three properties follow that a ranking cannot have:
;;;    * evidence is additive — agreement is represented, not adjudicated
;;;    * intent persists across ticks — an activation survives until it decays
;;;    * the temporal dimension exists — windows, impede, and Cronos
;;;
;;;  Ties break on the proposing Actor's :Rank, so selection stays
;;;  deterministic and a failed fix reproduces its baseline exactly.
;;; *************************************************************************************

(extend Coordination

  ;; ── the Deliberation record ───────────────────────────────
  ;; The decision function's working memory, persisted.  The
  ;; portal renders THIS row — there is no second, post-hoc story.

  (relation Deliberation
    :M
    :Telon       nil
    :Candidates  {}    ; {(idiom :Trial t :Act a :Basis b :Pulses n :Verdict v)}
    :Chosen      nil
    :Outcome     nil   ; confirmed | surprised
    :Diff        {}
    :Moment      0
  )


  ;; ── DELIBERATOR ───────────────────────────────────────────

  (function deliberate {}
    (var ?reality (setting u-GIL Decision :Reality))
    (var ?floor   (setting u-GIL Decision :MinPulses))

    ;; gather every proposal standing in Desired
    (var ?cands {})
    (with [Trial :M as ?t :Action as ?a :Basis as ?b :Doing = idle]
          [Activation :M = ?t :Reality = ?reality :Pulses as ?n]
          (>= ?n ?floor)
      do (set ?cands (append ?cands
           (idiom :Trial ?t :Act ?a :Basis ?b :Pulses ?n
                  :Rank (rank-of ?b)))))

    (when (void-p ?cands) (return nil))

    ;; the most activated wins; equal activation breaks on rank
    (var ?best  nil)
    (var ?bestn -1)
    (var ?bestr 99999)
    (for ?c in ?cands
      (when (or (> (:Pulses ?c) ?bestn)
                (and (= (:Pulses ?c) ?bestn) (< (:Rank ?c) ?bestr)))
        (do (set ?best  ?c)
            (set ?bestn (:Pulses ?c))
            (set ?bestr (:Rank   ?c)))))

    ;; the homework: every candidate, its proposer, its standing
    (var ?marked
      (collect ?c in ?cands
        list (idiom :Trial   (:Trial  ?c)
                    :Act     (:Act    ?c)
                    :Basis   (:Basis  ?c)
                    :Pulses  (:Pulses ?c)
                    :Verdict (if (= (:Trial ?c) (:Trial ?best))
                                 chosen else rejected))))

    (var ?d (reifier))
    (new Deliberation :M ?d :Telon (current-telon)
                      :Candidates ?marked
                      :Chosen (:Trial ?best)
                      :Moment (moment))

    ;; release it to the Executor
    (put [Trial :M = (:Trial ?best)] :Doing todo)

    ;; losers subside — they are not impeded, merely not renewed,
    ;; so a proposal that keeps being made keeps standing
    ?d)

  ;; rank-of — the proposing Actor's tie-break order.
  (function rank-of {literal ?basis}
    (with [Actor :Name = ?basis :Rank as ?r] give ?r else 500))

  ;; current-telon — the highest-scoring agendum.
  (function current-telon {}
    (var ?telon nil)
    (var ?best -1)
    (with [Agenda ^ as ?ag :Telon as ?t]
      do (var ?s (score ?ag))
         (when (> ?s ?best) (do (set ?best ?s) (set ?telon ?t))))
    ?telon)

  (agent Deliberator
    (function {} (deliberate))
    "locus://sol.earth.orb.local.host/mind/deliberator"
    (function {?sender ?msg} told)
    \@m{1})


  ;; ── the proposer ranks ────────────────────────────────────
  ;; Lower rank wins a tie.  This is NOT a score: it never
  ;; outweighs activation, it only orders equals.  Direct
  ;; evidence first, prospect last.

  (new Actor :Name Kace         :Mechanism rule :Rank 10)
  (new Actor :Name Reactor      :Mechanism rule :Rank 20)
  (new Actor :Name Navigator    :Mechanism agent :Rank 30)
  (new Actor :Name Imaginer     :Mechanism agent :Rank 40)
  (new Actor :Name Explorer     :Mechanism rule :Rank 50)
  (new Actor :Name Requestioner :Mechanism rule :Rank 60)
  (new Actor :Name Holder       :Mechanism rule :Rank 70)

) ;; end extend Coordination

;;; ---------------  end of file -----------------
