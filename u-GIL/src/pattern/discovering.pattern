;;; *************************************************************************************
;;;  discovering.pattern — hypotheses (Reflection)
;;;
;;;  Confidence is TWO-SIDED.  :Backward is retrodictive — I saw this happen
;;;  and attributed a cause.  :Forward is predictive — I said it would happen
;;;  and it did.  :Confidence is their mean.
;;;
;;;  That distinction matters: a belief formed by explaining the past is not
;;;  the same as one that has survived a test, and a single fluke should
;;;  never overturn either.
;;;
;;;    ASCRIBER      an Event with context and result becomes a Causes.
;;;    PREDICTOR     an active premise mints a Prediction with a deadline.
;;;    EXPERIMENTER  a low-confidence hypothesis gets deliberately tested.
;;; *************************************************************************************

(extend Reflection

  ;; ── ASCRIBER — retrodiction ───────────────────────────────

  (rule Ascriber
    memo "An Event with a context and a result becomes a causal hypothesis."
    domain Wisdom
    salience 8000
    with [Event :M as ?ev :What as ?deed :Why as ?telon]
         (> ?deed 0)                                   ; the thesis, not the dyad
         [Action :M = ?deed :Context as ?ctx]
         [Scheme :M = ?deed :E as ?result]
         (more-p ?ctx)
         (more-p ?result)
         (notany [Causes :Premise as ?p :Surmise as ?s]
                 (subset-p ?ctx ?p) (subset-p ?result ?s))
    do
      ;; retrodictive: modest backward confidence, no forward yet
      (schema Causes { :Premise ?ctx :Surmise ?result
                       :Support open :Confidence 0.1
                       :Forward 0 :Backward 0.2 }))


  ;; ── PREDICTOR — commit to a claim ─────────────────────────

  (rule Predictor
    memo "An active premise mints a Prediction with a deadline."
    domain Wisdom
    salience 8000
    with [Causes :M as ?hyp :Premise as ?premise :Support = open]
         (happening-p ?premise (V Awareness) Observed)
         (notany [Prediction :Hypothesis = ?hyp :Outcome = pending])
    do
      (schema Prediction { :Hypothesis ?hyp
                           :Deadline (+ (moment)
                                        (setting Registry Discovery :PredictionWindow))
                           :Outcome pending :Moment (moment) }))

  (rule Prediction-Correlator
    memo "Resolve a pending Prediction and move its hypothesis' forward confidence."
    domain Wisdom
    salience 10000
    with [Prediction ^ as ?p :M as ?pred :Outcome = pending
                     :Deadline as ?dl :Hypothesis as ?hyp]
         [Causes ^ as ?c :M = ?hyp :Surmise as ?surmise
                 :Forward as ?fwd :Backward as ?bwd]
    do
      (if (happening-p ?surmise (V Awareness) Observed)
          (do
            (put ?p :Outcome succeeded)
            (var ?new (min 1 (+ ?fwd 0.2)))
            (put ?c :Forward ?new :Confidence (/ (+ ?new ?bwd) 2)))
       or (> (moment) ?dl)
          (do
            (put ?p :Outcome failed)
            (var ?new (max 0 (- ?fwd 0.2)))
            (put ?c :Forward ?new :Confidence (/ (+ ?new ?bwd) 2)))))


  ;; ── EXPERIMENTER — test what is uncertain ─────────────────
  ;;
  ;; A hypothesis below the confidence bar is worth deliberately
  ;; setting up and testing, rather than waiting to stumble on
  ;; the evidence.

  (rule Designer
    memo "A low-confidence hypothesis gets an Experiment."
    domain Wisdom
    salience 8000
    with [Causes :M as ?hyp :Premise as ?premise :Surmise as ?surmise
                 :Support = open :Confidence as ?conf]
         (< ?conf (setting Registry Discovery :ConfidenceThreshold))
         [Action :M as ?test]
         [Scheme :M = ?test :E as ?result]
         (some ?r in ?result (in ?surmise ?r))
         (notany [Experiment :Hypothesis = ?hyp :Doing = idle])
    do
      (schema Experiment { :Hypothesis ?hyp :Setup ?premise :Test ?test
                           :Expected ?surmise :Actual {} :Verdict nil
                           :Doing idle }))

  (rule Experimenter-Setup
    memo "Establish an Experiment's setup conditions as sub-telons."
    domain Wisdom
    salience 8000
    with [Experiment ^ as ?e :M as ?exp :Setup as ?setup :Doing = idle]
    do
      (put ?e :Doing setup)
      (for ?condition in ?setup
        (unless (happening-p {?condition} (V Awareness) Observed)
          (new Agenda :Telon ?condition :Priority 1 :Urgency 0
                      :Exec idle :Plan todo :For (L Life)
                      :By infinity :Since (moment)))))

  (rule Experimenter-Test
    memo "Setup holds — propose the test act."
    domain Wisdom
    salience 8000
    with [Experiment ^ as ?e :M as ?exp :Setup as ?setup :Test as ?test
                     :Doing = setup]
         (happening-p ?setup (V Awareness) Observed)
    do
      (put ?e :Doing test)
      (var ?t (schema Trial { :Action ?test :Basis Experimenter :Dream nil
                              :Doing idle :Moment (moment) }))
      (enable :reifiers {?t} :moment (moment) :reality Desired))

  (rule Experimenter-Judge
    memo "Compare the Experiment's actual result to what was expected."
    domain Wisdom
    salience 8000
    with [Experiment ^ as ?e :M as ?exp :Expected as ?expected
                     :Hypothesis as ?hyp :Doing = test :Test as ?test]
         [Attempt :Act as ?a :Exec = done]
         [Action :M = ?test :Goals as ?goals] (in ?a ?goals)
    do
      (var ?hits  (# (collect ?x in ?expected (is-active ?x Observed) list ?x)))
      (var ?total (# ?expected))
      (var ?verdict (if (= ?hits ?total) confirmed
                        or (> ?hits 0)   partial
                        else             disconfirmed))
      (put ?e :Verdict ?verdict :Doing done)
      (var ?delta (case ?verdict of confirmed 0.2 of partial 0.1
                                 of disconfirmed -0.2 else 0))
      (var ?sup   (case ?verdict of confirmed confirmed
                                 of disconfirmed disconfirmed else open))
      (with [Causes ^ as ?c :M = ?hyp :Forward as ?fwd :Backward as ?bwd]
        do
        (var ?new (clamp (+ ?fwd ?delta) 0 1))
        (put ?c :Forward ?new :Confidence (/ (+ ?new ?bwd) 2) :Support ?sup)))

  (agent Ascriber
    (function {}
      (with [Event :M as ?ev :What as ?deed]
            (> ?deed 0)
        do (ascribe ?deed)))
    "locus://sol.earth.orb.local.host/mind/ascriber"
    (function {?sender ?msg} told)
    \@m{300})

  (function ascribe {long ?deed}
    (with [Action :M = ?deed :Context as ?ctx]
          [Scheme :M = ?deed :E as ?res]
          (and (more-p ?ctx) (more-p ?res))
      do (unless (any [Causes :Premise as ?p] (subset-p ?ctx ?p))
           (schema Causes { :Premise ?ctx :Surmise ?res :Support open
                            :Confidence 0.1 :Forward 0 :Backward 0.2 }))))

  (agent Predictor
    (function {}
      (with [Causes :M as ?hyp :Premise as ?premise :Support = open]
            (happening-p ?premise (V Awareness) Observed)
        do (unless (any [Prediction :Hypothesis = ?hyp :Outcome = pending])
             (schema Prediction
               { :Hypothesis ?hyp
                 :Deadline (+ (moment)
                              (setting Registry Discovery :PredictionWindow))
                 :Outcome pending :Moment (moment) }))))
    "locus://sol.earth.orb.local.host/mind/predictor"
    (function {?sender ?msg} told)
    \@m{50})

  (agent Experimenter
    (function {}
      (with [Experiment :M as ?exp :Doing = idle]
        do (put [Experiment :M = ?exp] :Doing setup)))
    "locus://sol.earth.orb.local.host/mind/experimenter"
    (function {?sender ?msg} told)
    \@m{100})

) ;; end extend Reflection

;;; ---------------  end of file -----------------
