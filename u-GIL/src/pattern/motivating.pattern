;;; *************************************************************************************
;;;  motivating.pattern — needs become objectives (Reflection)
;;;
;;;  An urge arrives from the body (low battery, imbalance) or from the world
;;;  (inefficiency).  The Ameliorator turns it into an Agenda item whose telon
;;;  is the DYAD of the need — the state in which the need is absent.
;;;
;;;  In the Eidos the only standing need is progress.  In the Expanse there
;;;  are five, and they compete.  Same mechanism.
;;; *************************************************************************************

(extend Reflection

  (rule Ameliorator-Create
    memo "An unaddressed urge becomes an Agenda item."
    domain Wisdom
    salience 10000
    with [Need :Name as ?name :M as ?need :Urgency as ?urg]
         (/= ?urg 0)
         (notany [Agenda :Telon = (dyad ?need)])
    do
      (new Agenda :Telon (dyad ?need) :Priority 0 :Urgency ?urg
                  :Exec idle :Plan todo :For (L Life)
                  :By infinity :Since (moment))
      (enable :reifiers {(dyad ?need)} :moment (moment) :reality Desired))

  (rule Ameliorator-Update
    memo "Keep an Agenda item's urgency in step with its Need."
    domain Wisdom
    salience 10000
    with [Need :M as ?need :Urgency as ?urg]
         [Agenda ^ as ?agendum :Telon = (dyad ?need) :Urgency as ?old]
         (/= ?urg ?old)
    do
      (put ?agendum :Urgency ?urg))

  ;; ── PLANNER ───────────────────────────────────────────────
  ;;
  ;; A telon with a known Action that reaches it and satisfied
  ;; preconditions is ready to attempt.  One with unsatisfied
  ;; preconditions decomposes: each missing precondition becomes
  ;; its own sub-telon.
  ;;
  ;; This is what lets the Navigator plan high and still act low.
  ;; A Locale-level hop becomes a handful of Place-level sub-goals.

  (rule Planner-Direct
    memo "A telon reachable by a ready Action needs no decomposition."
    domain Wisdom
    salience 9970
    with [Agenda ^ as ?agendum :Telon as ?telon :Plan = todo]
         [Action :M as ?act :Context as ?ctx]
         [Scheme :M = ?act :E as ?res]
         (in ?telon ?res)
         (every ?p in ?ctx (is-active ?p Observed))
    do
      (put ?agendum :Plan sent))

  (rule Planner-Subgoal
    memo "Unsatisfied preconditions become sub-telons of their own."
    domain Wisdom
    salience 9960
    with [Agenda ^ as ?agendum :Telon as ?telon :Plan = todo]
         [Action :M as ?act :Context as ?ctx]
         [Scheme :M = ?act :E as ?res]
         (in ?telon ?res)
         (some ?p in ?ctx (not (is-active ?p Observed)))
    do
      (put ?agendum :Plan busy)
      (for ?p in ?ctx
        (unless (is-active ?p Observed)
          (unless (any [Agenda :Telon = ?p])
            (new Agenda :Telon ?p
                        :Priority (+ (:Priority ?agendum) 1)
                        :Urgency  (:Urgency ?agendum)
                        :Exec idle :Plan todo :For (:For ?agendum)
                        :By (:By ?agendum) :Since (moment))
            (enable :reifiers {?p} :moment (moment) :reality Desired)))))

  (rule Planner-Problem
    memo "A telon no Action reaches is posed as a Problem."
    domain Wisdom
    salience 9800
    with [Agenda ^ as ?agendum :Telon as ?telon :Plan = todo]
         (notany [Scheme :M as ?a :R = (R Action) :E as ?res] (in ?telon ?res))
    do
      (var ?prob (schema Problem { :Context {} :Desired {?telon}
                                   :Status open :Domain Wisdom }))
      (enable :reifiers {?prob} :moment (moment) :reality Observed)
      (put ?agendum :Plan busy))

  (agent Ameliorator
    (function {}
      (with [Need :M as ?need :Urgency as ?urg]
            (/= ?urg 0)
        do (unless (any [Agenda :Telon = (dyad ?need)])
             (new Agenda :Telon (dyad ?need) :Priority 0 :Urgency ?urg
                         :Exec idle :Plan todo :For (L Life)
                         :By infinity :Since (moment)))))
    "locus://sol.earth.orb.local.host/mind/ameliorator"
    (function {?sender ?msg} told)
    \@m{50})

) ;; end extend Reflection

;;; ---------------  end of file -----------------
