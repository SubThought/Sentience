;;; *************************************************************************************
;;;  regulating.pattern — grading the consequence (Reflection)
;;;
;;;  Where an Attempt becomes evidence, and a failure becomes a QUESTION.
;;;
;;;  ACTION-CORRELATOR mints the Event on BOTH branches:
;;;      success  ->  :What = the Action monad        (the grasp occurred)
;;;      failure  ->  :What = (antith ?action)        (the NOT-grasp occurred)
;;;
;;;  The dyad makes failure first-class.  "All my failures at X" becomes a
;;;  queryable monad with its own activation history; repeated failures share
;;;  it; reasoners chain over it.
;;;
;;;  REGULATOR then does what u-GIL 1.0 could not: on failure it mints an
;;;  impediment, synthesises its antithesis as an enablement, clones the
;;;  Action with that enablement in :Context, mints a Causes hypothesis with
;;;  an EMPTY premise, and posts an agenda item — discover what causes it.
;;;
;;;  The mind asks what is blocking it.
;;; *************************************************************************************

(extend Reflection

  ;; ── ACTION-CORRELATOR ─────────────────────────────────────

  (rule Action-Correlator
    memo "Settle an Attempt: grade it, mint the Event on either pole, tell the Regulator."
    domain Wisdom
    salience 10000
    with [Attempt ^ as ?attempt :Trial as ?trial :Telon as ?telon
                  :Act as ?actuation :Exec = sent]
         [Trial :M = ?trial :Action as ?action]
         [Scheme :M = ?action :E as ?expected]
    do
      (put ?attempt :Exec done :When (moment))

      ;; did the postconditions the model predicted actually arrive?
      (var ?succeeded
        (if (void-p ?expected)
            no                                    ; nothing predicted: the
                                                  ; Elaborator will fill it
            (happening-p ?expected (V Awareness) Observed)))

      (when ?succeeded
        (enable :reifiers {?action} :moment (moment) :reality Observed)
        (with [Utility ^ as ?u :M = ?action :Successes as ?s]
          do (put ?u :Successes (+ ?s 1))))

      (unless ?succeeded
        (with [Agenda ^ as ?ag :Telon = ?telon] do (put ?ag :Plan fail)))

      ;; ── the Event: what actually occurred, either pole ──
      ;; Events are occurrence TYPES, so identity is exact: the
      ;; same deed in the same place for the same reason is ONE
      ;; Event, re-enabled, with its recurrence in the activation
      ;; record.
      (var ?deed  (if ?succeeded ?action (antith ?action)))
      (var ?where (current-venue))
      (var ?traits (sort {(L I_AM) ?deed ?where ?telon ?actuation} <))

      (var ?event (identical ?traits Event))
      (unless (thing-p ?event)
        (set ?event (schema Event { :Who {(L I_AM)} :What ?deed
                                    :Where ?where :When nil :Why ?telon
                                    :How ?actuation :With {} :Whom {}
                                    :View (V Awareness) }))
        (store ?event Event ?traits))
      (enable :reifiers {?event} :moment (moment) :reality Observed)

      ;; ── accommodation: was the prediction right? ──
      ;; Surprise is Expected-versus-Observed at the :Result
      ;; monads.  A miss corrects the scheme at the point of
      ;; surprise, not globally.
      (var ?missed
        (collect ?r in ?expected
          (not (is-active ?r Observed))
          list ?r))
      (when (more-p ?missed)
        (accommodate ?action ?missed))

      ;; hand the outcome to the Regulator
      (regulate ?action ?telon (if ?succeeded 1 -1)))


  ;; accommodate — the model was wrong HERE.  Drop the
  ;; postconditions that did not arrive; the Elaborator will
  ;; re-learn them from the next attempt.
  (function accommodate {long ?action list ?missed}
    (with [Scheme ^ as ?s :M = ?action :E as ?res]
      do
      (var ?kept (collect ?r in ?res (not (in ?missed ?r)) list ?r))
      (put ?s :E ?kept)
      (put [Action :M = ?action] :Result ?kept))
    (new Origin :M ?action :Provenance Edited :Mechanism Correlator
                :Moment (moment)))


  ;; ── REGULATOR ─────────────────────────────────────────────

  (function regulate {long ?action variant ?telon integer ?value}
    ;; affect follows reliability
    (var ?rel (reliability ?action))
    (with [Emotion ^ as ?e :M = ?action]
      do (put ?e :Valence ?rel)
      else (new Emotion :M ?action :Valence ?rel
                        :Arousal 0 :Approach 0 :Power 0))

    ;; ── failure learning ──
    (when (= ?value -1)
      (with [Action :M = ?action :Context as ?ctx :Goals as ?goals]
        do
        ;; something is in the way.  Name it, and name its absence.
        (var ?impediment (reifier))
        (var ?enablement (antith ?impediment))

        ;; a variant of this Action that would work IF the
        ;; enablement held
        (var ?variant
          (schema Action { :Context (append ?ctx {?enablement})
                           :Goals   ?goals
                           :Loop    (R Once)
                           :For     (L Life)
                           :Result  {} }))
        (new Origin :M ?variant :Provenance Copied :Mechanism Regulator
                    :Source ?action :Moment (moment))

        ;; what would produce the enablement?  Unknown — that is
        ;; the question.
        (var ?cause
          (schema Causes { :Premise {} :Surmise {?enablement}
                           :Support open :Confidence 0
                           :Forward 0 :Backward 0 }))

        ;; put the question on the agenda
        (new Agenda :Telon ?cause :Priority 1 :Urgency 0
                    :Exec idle :Plan todo :For (L Life)
                    :By infinity :Since (moment)))))

  (agent Regulator
    (function {}
      (with [Attempt :Exec = sent :Trial as ?t]
        do (correlate-attempt ?t)))
    "locus://sol.earth.orb.local.host/mind/regulator"
    (function {?sender ?msg} told)
    \@m{1})

  ;; correlate-attempt — the same body the rule runs, callable
  ;; directly where the rules engine is unavailable.
  (function correlate-attempt {long ?trial}
    (with [Attempt ^ as ?a :Trial = ?trial :Exec = sent]
      do (put ?a :Exec done :When (moment))))


  ;; ── TERMINATOR ────────────────────────────────────────────
  ;; The objective arrived.  Free the agendum so the mind stops
  ;; pursuing what it already has.

  (rule Terminator
    memo "Free an Agenda item once its telon holds in Observed."
    domain Wisdom
    salience 10000
    with [Agenda ^ as ?agendum :Telon as ?telon]
         (happening-p {?telon} (V Awareness) Observed)
    do
      (free ?agendum))

) ;; end extend Reflection

;;; ---------------  end of file -----------------
