;;;
;;; Top-level entry point for the GIL sentient being.
;;;
;;; Imports all component modules and the shared Totality knowledge base,
;;; declares the Wisdom domain, states the Self-Actualization problem,
;;; and launches via start-mind.
;;;
;;; GIL Component architecture:
;;;
;;;   ┌──────────────────────────────────────────────────────────┐
;;;   │  Observation   Coordination   Reflection   Consolidation │
;;;   │                                                          │
;;;   │  (observe)     (coordinate)   (reflect)    (consolidate) │
;;;   │       │              │             │              │      │
;;;   │       │    ┌─────────────────────────────────┐    │      │
;;;   │       └────│            Totality             │────┘      │
;;;   │            │  Perceptual  · Associative      │           │
;;;   │            │  Imaginative · Ontological      │           │
;;;   │            │  Activative  · Control          │           │
;;;   │            └─────────────────────────────────┘           │
;;;   └──────────────────────────────────────────────────────────┘
;;;
;;;
;;;    ─────────────────────────────────────────────────────────────
;;;     §5  LAUNCH
;;;    
;;;     start-mind (control.memory) launches all four components plus
;;;     think, and registers Actors into Mind :Mechanisms, enabling
;;;     pause/resume/stop/mind-health.
;;;    ─────────────────────────────────────────────────────────────
;;;
;;;
;;; GIL.being — Generally Intelligent Learner
;;;

(theory GIL

  (require  Totality       from "totality.memoria"       or abort)
  (require  Observation    from "observation.process"    or abort)
  (require  Coordination   from "coordination.process"   or abort)
  (require  Reflection     from "reflection.process"     or abort)
  (require  Consolidation  from "consolidation.process"  or abort)

  ;;; THE DASHBOARD IS NOT REQUIRED HERE, AND MUST NOT BE.
  ;;;
  ;;; dashboard.theory ENDS WITH (dashboard-run), so requiring it
  ;;; would start a dashboard inside every mind — two learners, two
  ;;; Curators, two servers fighting over one port.
  ;;;
  ;;; And the deeper reason: THE CURATOR EXISTS PARTLY TO RECORD THAT
  ;;; A LEARNER FELL OVER.  Owned by a learner's process it dies with
  ;;; the learner, and the notice that would have said so goes with
  ;;; it.  The observer cannot outlive the observed if the observed is
  ;;; holding it up.
  ;;;
  ;;; What a learner requires is attending.process — its own device,
  ;;; its own enrolment, its own heartbeat.  It will START a dashboard
  ;;; if it finds none answering, detached and unowned, which is a
  ;;; convenience rather than a possession.
  
  
  (require  Attending      from "attending.process"  or abort)

  ;;; THE KNOWLEDGE BASE IS THE DAICHO'S TO NAME.  It was written here
  ;;; as a literal and configured there as well, which is two places to
  ;;; change and one to forget.  The portal reads the same setting, so
  ;;; the mind and its audit surface cannot end up looking at two
  ;;; different Totalities.
  
  
  (use (lore url (setting GIL Totality :Url))

    (domain Wisdom

      (problem Self-Actualization
        state (assume Novelty :Facts [I_AM])))

    (start-mind GIL)

    ;;; AFTER start-mind, DELIBERATELY.  The Registrar exists before
    ;;; Eidos announces itself, so registration succeeds first time
    ;;; rather than spending the device's retries proving the mind was
    ;;; not up yet.
    ;;;
    ;;; ONE CALL, AND IT IS THE LEARNER'S OWN.
    ;;;
    ;;; It was (dashboard-run) — the mind starting the whole audit
    ;;; surface, which was right while GIL was one mind and is wrong
    ;;; now.  A learner starts ITS BODY, sees to a dashboard if none
    ;;; is answering, announces itself, and beats.  The dashboard is
    ;;; started by grokking dashboard.theory, by whoever runs it.
    ;;;
    ;;; EVERY STEP IS BEST-EFFORT.  A device that will not start, a
    ;;; dashboard that is not there, a Curator that is not listening —
    ;;; none of them stops a mind from thinking, and none of them
    ;;; should.  A headless run sets [Dashboard :Autostart no] and
    ;;; opens nothing at all.
    (attend)

  ) ;; end use Totality

) ;; end theory GIL


;;; ─────────────────────────────────────────────────────────────
;;;                   END OF FILE
;;; ─────────────────────────────────────────────────────────────
