;;;
;;; Requires ten patterns and provides the reflect launcher.
;;; No trailing (think) — start-mind owns think.
;;;
;;; reflection.process — Reflection component manifest.
;;;

(theory Reflection {10 0 0}

  "Reflection component — ten metacognitive design patterns."

  (require  Reflection  from  "../pattern/motivating.pattern"    or abort)
  (require  Reflection  from  "../pattern/simulating.pattern"    or abort)
  (require  Reflection  from  "../pattern/regulating.pattern"    or abort)
  (require  Reflection  from  "../pattern/compensating.pattern"  or abort)
  (require  Reflection  from  "../pattern/coping.pattern"        or abort)
  (require  Reflection  from  "../pattern/exploring.pattern"     or abort)
  (require  Reflection  from  "../pattern/discovering.pattern"   or abort)
  (require  Reflection  from  "../pattern/imitating.pattern"     or abort)
  (require  Reflection  from  "../pattern/playing.pattern"       or abort)
  
  
  ;;; DREAMING AFTER PLAYING, and beside it for a reason: Piaget's
  ;;; poles are imitation, accommodation-dominant, and play,
  ;;; assimilation-dominant.  Dreaming is play taken to its limit —
  ;;; assimilation with no accommodation at all, exercising schemes
  ;;; for their own sake with nothing to answer to.
  (require  Reflection  from  "../pattern/dreaming.pattern"      or abort)
  (require  Reflection  from  "../pattern/monitoring.pattern"    or abort)


  ; ─────────────────────────────────────────────────────────────
  ; REFLECT LAUNCHER
  ;
  ; Starts Supervisor, Aggregator, Monitor, Modifier.
  ; No trailing (think) — think is owned by start-mind.
  ; ─────────────────────────────────────────────────────────────

  (function reflect {}
    ;;; THE REGISTRY IS MINTED BEFORE MONITORING WATCHES IT.  Monitor
    ;;; and CompetencyWatch reconcile rows against mechanisms; with no
    ;;; rows there is nothing to reconcile, and a competency the
    ;;; daicho disabled at cold start would come up anyway.
    (competency-bootstrap)

    (concurrent
      (tell Supervisor START)
      (tell Aggregator START)
      (tell Monitor START)
      (tell Modifier START)
      (tell CompetencyWatch START)))


) ;; end theory Reflection

;; ---------------  end of file -----------------
